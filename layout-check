#!/usr/bin/env python3
"""Runs layoutcheck from a checkout of this repository: ./layout-check BASE CANDIDATE (see --help)."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from layoutcheck.cli import main  # noqa: E402

if __name__ == "__main__":  # spawned worker processes import this file again
    sys.stdout.reconfigure(line_buffering=True)
    sys.exit(main())
